# Optional Map API Keys for Custom Map Tiles
# If left blank, EarthPulse automatically defaults to high-speed free OpenStreetMap & Carto Fastly tiles without requiring an API key.

# 1. Mapbox (Dark v11 Style) - Get a free key at: https://account.mapbox.com/auth/signup/
VITE_MAPBOX_TOKEN=

# 2. CARTO Basemaps - Get a free key at: https://carto.com/signup/
VITE_CARTO_API_KEY=

# 3. Stadia Maps (Alidade Smooth Dark) - Get a free key at: https://client.stadiamaps.com/signup/
VITE_STADIA_API_KEY=
